# ---------- Database (PostgreSQL 14+) ----------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/brokersodo?sslmode=require"

# ---------- Auth.js ----------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
# Keep this stable: it also protects the private original-photo paths.
AUTH_SECRET=""

# ---------- Site ----------
# Public URL, no trailing slash. Used for canonical URLs, sitemap, OG images, share links.
SITE_URL="https://brokersodo.com"
NEXT_PUBLIC_SITE_URL="https://brokersodo.com"

# ---------- First admin user (read by `npm run db:seed:launch`) ----------
SEED_ADMIN_EMAIL="admin@brokersodo.com"
# Use 12 or more characters. Remove this variable after the first launch.
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="BrokerSodo Admin"

# ---------- Image storage (S3-compatible; AletCloud Storage in production) ----------
# Leave empty in development to store uploads in /public/uploads.
S3_ENDPOINT="https://s3.aletcloud.com"
S3_REGION="et-addis-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL of the bucket, no trailing slash.
S3_PUBLIC_URL=""

# ---------- Optional runtime tuning ----------
# Node heap limit in MB for the Docker container (default 320, suits a 512Mi plan).
# NODE_HEAP_MB="320"
