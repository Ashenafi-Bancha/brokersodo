# ---------- Database (PostgreSQL 14+; Neon or Supabase in production) ----------
# Pooled connection used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/brokersodo?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate` (same as DATABASE_URL if you have no pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/brokersodo?sslmode=require"

# ---------- Auth.js ----------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# ---------- Site ----------
# Public URL, no trailing slash. Used for canonical URLs, sitemap, OG images, share links.
NEXT_PUBLIC_SITE_URL="https://brokersodo.com"

# ---------- First admin user (read by `npm run db:seed`) ----------
SEED_ADMIN_EMAIL="admin@brokersodo.com"
SEED_ADMIN_PASSWORD="change-me-to-a-long-password"
SEED_ADMIN_NAME="BrokerSodo Admin"

# ---------- Cloudinary (image upload/CDN). Leave empty in dev to store uploads in /public/uploads ----------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Public ID of the watermark overlay you uploaded to Cloudinary (e.g. "brokersodo/brand/watermark").
# Upload /public/brand/logo/png/logo-horizontal-white-600.png for it.
NEXT_PUBLIC_CLOUDINARY_WATERMARK_ID=""
