// BrokerSodo — Phase 1 data model
// Full-text search: `Listing.searchVector` is maintained by a Postgres trigger
// (see prisma/migrations/*_search/migration.sql). Fuzzy matching uses pg_trgm.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent]
}

enum Role {
  ADMIN
  BROKER
}

enum DealType {
  SALE
  RENT
}

enum RentPeriod {
  DAY
  MONTH
  YEAR
}

enum Condition {
  NEW
  USED
  REFURBISHED
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  RESERVED
  SOLD
  RENTED
  ARCHIVED
}

enum ContactMethod {
  CALL
  TELEGRAM
  WHATSAPP
}

enum InquiryStatus {
  NEW
  CONTACTED
  VIEWING_SCHEDULED
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WantedStatus {
  OPEN
  MATCHED
  CLOSED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role      @default(BROKER)
  avatar       String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  listings  Listing[]     @relation("AssignedBroker")
  inquiries Inquiry[]     @relation("InquiryBroker")
  activity  ActivityLog[]

  @@index([role, isActive])
}

model Category {
  id              String     @id @default(cuid())
  nameEn          String
  nameAm          String?
  slug            String     @unique
  /// Short prefix used in reference codes, e.g. "V" -> BS-V-0142
  refPrefix       String     @default("X")
  /// Brand icon key, maps to /brand/icons/svg/ic-{icon}-navy.svg
  icon            String     @default("other")
  image           String?
  descriptionEn   String?
  descriptionAm   String?
  sortOrder       Int        @default(0)
  isActive        Boolean    @default(true)
  parentId        String?
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[] @relation("CategoryTree")
  /// Array of AttributeField — see src/lib/validators/attribute-schema.ts
  attributeSchema Json       @default("[]")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  listings    Listing[]
  submissions PropertySubmission[]
  wanted      WantedRequest[]

  @@index([isActive, sortOrder])
  @@index([parentId])
}

model Area {
  id        String   @id @default(cuid())
  nameEn    String
  nameAm    String?
  slug      String   @unique
  city      String   @default("Wolaita Sodo")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings      Listing[]
  submissions   PropertySubmission[]
  wanted        WantedRequest[]
  jobs          JobPost[]
  jobSeekers    JobSeeker[]
  tutors        Tutor[]
  tutorRequests TutorRequest[]
  companies     Company[]

  @@index([sortOrder])
}

/// Per-prefix counter used to allocate reference codes atomically.
model RefCounter {
  prefix String @id
  value  Int    @default(0)
}

model Listing {
  id            String  @id @default(cuid())
  refCode       String  @unique
  slug          String  @unique
  titleEn       String
  titleAm       String?
  /// Sanitised HTML
  descriptionEn String  @default("")
  descriptionAm String?
  videoUrl      String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  dealType       DealType
  rentPeriod     RentPeriod?
  /// Whole Ethiopian Birr
  price          Int?
  isNegotiable   Boolean     @default(false)
  priceOnRequest Boolean     @default(false)
  condition      Condition?

  areaId      String?
  area        Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)
  addressHint String?
  /// Approximate location — rendered as a privacy circle, never a pin
  lat         Float?
  lng         Float?

  attributes Json @default("{}")

  status        ListingStatus @default(DRAFT)
  isVerified    Boolean       @default(false)
  isInspected   Boolean       @default(false)
  featured      Boolean       @default(false)
  featuredUntil DateTime?

  assignedBrokerId String?
  assignedBroker   User?   @relation("AssignedBroker", fields: [assignedBrokerId], references: [id], onDelete: SetNull)

  // ---- PRIVATE: staff only. Never select on public routes. ----
  ownerName  String?
  ownerPhone String?
  ownerNotes String?

  viewCount   Int       @default(0)
  publishedAt DateTime?
  soldAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  searchVector Unsupported("tsvector")?

  images      ListingImage[]
  inquiries   Inquiry[]
  submissions PropertySubmission[]
  wanted      WantedRequest[]      @relation("WantedMatches")

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status])
  @@index([areaId, status])
  @@index([dealType, status])
  @@index([price])
  @@index([featured, status])
  @@index([assignedBrokerId])
  @@index([searchVector], type: Gin)
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  publicId  String?
  width     Int      @default(1200)
  height    Int      @default(900)
  alt       String?
  blurData  String?
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([listingId, sortOrder])
}

model Inquiry {
  id               String        @id @default(cuid())
  listingId        String?
  listing          Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  name             String
  phone            String
  message          String?
  preferredContact ContactMethod @default(CALL)
  /// e.g. listing, contact, home
  source           String        @default("listing")
  status           InquiryStatus @default(NEW)
  assignedBrokerId String?
  assignedBroker   User?         @relation("InquiryBroker", fields: [assignedBrokerId], references: [id], onDelete: SetNull)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([listingId])
  @@index([assignedBrokerId])
  @@index([createdAt])
}

model PropertySubmission {
  id              String           @id @default(cuid())
  name            String
  phone           String
  categoryId      String?
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  dealType        DealType
  rentPeriod      RentPeriod?
  title           String
  details         String?
  attributes      Json             @default("{}")
  expectedPrice   Int?
  areaId          String?
  area            Area?            @relation(fields: [areaId], references: [id], onDelete: SetNull)
  /// Array of { url, publicId, width, height }
  photos          Json             @default("[]")
  status          SubmissionStatus @default(PENDING)
  rejectReason    String?
  linkedListingId String?
  linkedListing   Listing?         @relation(fields: [linkedListingId], references: [id], onDelete: SetNull)
  staffNotes      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

model WantedRequest {
  id          String       @id @default(cuid())
  name        String
  phone       String
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  dealType    DealType
  description String
  budgetMin   Int?
  budgetMax   Int?
  areaId      String?
  area        Area?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  status      WantedStatus @default(OPEN)
  notes       String?
  matches     Listing[]    @relation("WantedMatches")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  quoteEn   String
  quoteAm   String?
  rating    Int      @default(5)
  avatar    String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id         String   @id @default(cuid())
  questionEn String
  questionAm String?
  answerEn   String
  answerAm   String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleEn   String
  titleAm   String?
  /// Sanitised HTML
  bodyEn    String   @default("")
  bodyAm    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Singleton — always id = "site"
model SiteSettings {
  id               String   @id @default("site")
  businessName     String   @default("BrokerSodo")
  taglineEn        String?
  taglineAm        String?
  phonePrimary     String   @default("+251900000000")
  phoneSecondary   String?
  telegramUsername String   @default("BrokerSodo")
  telegramChannel  String?
  whatsappNumber   String   @default("+251900000000")
  email            String?
  addressEn        String?
  addressAm        String?
  mapLat           Float    @default(6.8556)
  mapLng           Float    @default(37.7508)
  hoursEn          String?
  hoursAm          String?
  facebookUrl      String?
  tiktokUrl        String?
  instagramUrl     String?
  youtubeUrl       String?
  heroTitleEn      String?
  heroTitleAm      String?
  heroSubtitleEn   String?
  heroSubtitleAm   String?
  /// Overrides for the homepage counters (null = use live DB value)
  statListings     Int?
  statDeals        Int?
  statClients      Int?
  statYears        Int?
  seoTitle         String?
  seoDescription   String?
  updatedAt        DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  summary    String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

/// Simple fixed-window rate limiter store (works on serverless without Redis)
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

/**
 * ---------------- Jobs ----------------
 */

enum JobStatus {
  /// Submitted, waiting for staff
  PENDING
  UNDER_REVIEW
  PUBLISHED
  CLOSED
  REJECTED
}

/// Hiring pipeline: NEW (applied) → REVIEWING → SHORTLISTED → INTERVIEW → HIRED (selected) / REJECTED.
enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  CONTACTED
  INTERVIEW
  HIRED
  REJECTED
  WITHDRAWN
}

enum SeekerStatus {
  NEW
  ACTIVE
  PLACED
  ARCHIVED
}

/// Catalogue values (sector, jobType, ...) live in src/lib/jobs-catalog.ts.
model JobPost {
  id               String    @id @default(cuid())
  refCode          String    @unique
  slug             String    @unique
  title            String
  employerName     String
  /// false = confidential employer: the name is never sent to public pages
  showEmployer     Boolean   @default(true)
  employerVerified Boolean   @default(false)
  sector           String
  jobType          String
  /// GRADUATE, SKILLED or ANY
  audience         String    @default("ANY")
  education        String    @default("NONE")
  minExperience    Int       @default(0)
  vacancies        Int       @default(1)
  salaryMin        Int?
  salaryMax        Int?
  salaryPeriod     String    @default("MONTH")
  areaId           String?
  area             Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  description      String
  requirements     String    @default("")
  responsibilities String    @default("")
  skills           String[]  @default([])
  /// ONSITE, HYBRID or REMOTE
  workMode         String    @default("ONSITE")
  /// Optional public instructions; applications still go through BrokerSodo
  howToApply       String?
  deadline         DateTime?
  status           JobStatus @default(PENDING)
  featured         Boolean   @default(false)

  // ---- PRIVATE: staff only. Never select on public routes. ----
  contactName  String
  contactPhone String
  staffNotes   String?
  rejectReason String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications JobApplication[]

  /// Posted from a member account (employer dashboard); null = staff or the public form
  memberId  String?
  member    Member?    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  savedBy   SavedJob[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, deadline])
  @@index([sector, status])
  @@index([audience, status])
  @@index([areaId, status])
  @@index([workMode, status])
  @@index([skills], type: Gin)
  @@index([memberId])
  @@index([companyId])
}

/// Private: visible to staff only.
model JobApplication {
  id         String            @id @default(cuid())
  jobId      String
  job        JobPost           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  education  String
  field      String?
  experience Int               @default(0)
  skills     String?
  message    String?
  status     ApplicationStatus @default(NEW)
  notes      String?
  memberId   String?
  member     Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([jobId, phone])
  @@index([status, createdAt(sort: Desc)])
  @@index([memberId])
}

/// Private talent pool: skilled workers and graduates. Never shown publicly.
model JobSeeker {
  id             String          @id @default(cuid())
  name           String
  phone          String
  /// GRADUATE or SKILLED
  seekerType     String
  profession     String
  sector         String
  education      String
  field          String?
  graduationYear Int?
  experience     Int             @default(0)
  skills         String?
  about          String?
  /// PRIVATE (staff only) or PUBLIC (listed on Find Talent, first name only)
  visibility     String          @default("PRIVATE")
  /// Set when the profile is first made public
  slug           String?         @unique
  displayName    String?
  languages      String[]        @default([])
  certifications String?
  projects       String?
  portfolioUrl   String?
  availability   String?
  isVerified     Boolean         @default(false)
  publishedAt    DateTime?
  /// The member account that owns this profile (one per account)
  memberId       String?         @unique
  cv             CvFile?
  member         Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  areaId         String?
  area           Area?           @relation(fields: [areaId], references: [id], onDelete: SetNull)
  status         SeekerStatus    @default(NEW)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  talentRequests TalentRequest[]

  @@index([status, createdAt(sort: Desc)])
  @@index([sector, seekerType])
  @@index([phone])
  @@index([visibility, status, publishedAt(sort: Desc)])
}

enum TalentRequestStatus {
  NEW
  CONTACTED
  CONNECTED
  CLOSED
}

/// Private: an employer asking BrokerSodo to connect them with a listed candidate.
model TalentRequest {
  id           String              @id @default(cuid())
  seekerId     String?
  /// The employer's account, when they asked while signed in
  memberId     String?
  member       Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  seeker       JobSeeker?          @relation(fields: [seekerId], references: [id], onDelete: SetNull)
  employerName String
  contactName  String
  phone        String
  message      String?
  status       TalentRequestStatus @default(NEW)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([seekerId])
  @@index([memberId])
}

/**
 * ---------------- Tutors ----------------
 */

enum TutorStatus {
  PENDING
  ACTIVE
  HIDDEN
  REJECTED
}

enum TutorRequestStatus {
  NEW
  CONTACTED
  MATCHED
  COMPLETED
  CANCELLED
  CLOSED
}

model Tutor {
  id              String      @id @default(cuid())
  refCode         String      @unique
  slug            String      @unique
  /// Public: first name only
  displayName     String
  subjects        String[]
  levels          String[]
  modes           String[]
  education       String
  field           String?
  experienceYears Int         @default(0)
  bio             String
  availability    String?
  /// Whole ETB per hour
  hourlyRate      Int?
  /// Whole ETB per month (regular lessons)
  monthlyRate     Int?
  languages       String[]    @default([])
  /// Approved reviews only, kept in step by the review actions
  ratingAvg       Float       @default(0)
  ratingCount     Int         @default(0)
  /// The member account that owns this profile (one per account)
  memberId        String?     @unique
  member          Member?     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  areaId          String?
  area            Area?       @relation(fields: [areaId], references: [id], onDelete: SetNull)
  status          TutorStatus @default(PENDING)
  isVerified      Boolean     @default(false)
  featured        Boolean     @default(false)

  // ---- PRIVATE: staff only. Never select on public routes. ----
  fullName     String
  phone        String
  staffNotes   String?
  rejectReason String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  requests TutorRequest[]
  reviews  TutorReview[]

  @@index([status, featured, publishedAt(sort: Desc)])
  @@index([areaId, status])
  @@index([subjects], type: Gin)
  @@index([levels], type: Gin)
}

/// Private: a family or student asking for a tutor.
model TutorRequest {
  id            String             @id @default(cuid())
  tutorId       String?
  tutor         Tutor?             @relation(fields: [tutorId], references: [id], onDelete: SetNull)
  name          String
  phone         String
  subject       String
  level         String
  mode          String
  areaId        String?
  area          Area?              @relation(fields: [areaId], references: [id], onDelete: SetNull)
  schedule      String?
  budget        Int?
  message       String?
  status        TutorRequestStatus @default(NEW)
  notes         String?
  /// The family's account, when they asked while signed in
  memberId      String?
  member        Member?            @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// The tutor's answer from their dashboard: ACCEPTED or DECLINED
  tutorResponse String?
  respondedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  reviews TutorReview[]

  @@index([status, createdAt(sort: Desc)])
  @@index([tutorId])
  @@index([memberId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A family's review of a tutor. Shown only after staff approve it.
model TutorReview {
  id        String        @id @default(cuid())
  tutorId   String
  tutor     Tutor         @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  /// Set when the reviewer's phone matches a request matched to this tutor
  requestId String?
  request   TutorRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  /// Public: first name only
  name      String
  /// Private: staff only
  phone     String
  rating    Int
  comment   String
  verified  Boolean       @default(false)
  status    ReviewStatus  @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([tutorId, phone])
  @@index([tutorId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

/// De-duplicates listing view counts (hashed visitor + listing per day)
model ListingView {
  id        String   @id
  listingId String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/**
 * ---------------- Member accounts ----------------
 * Public visitors (job seekers, tutors, families, employers). Separate from staff `User`:
 * a member session can never open /admin.
 */
model Member {
  id           String    @id @default(cuid())
  name         String
  /// Normalised +2519…/+2517…; the sign-in name
  phone        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions       MemberSession[]
  seeker         JobSeeker?
  tutor          Tutor?
  company        Company?
  jobs           JobPost[]
  applications   JobApplication[]
  savedJobs      SavedJob[]
  tutorRequests  TutorRequest[]
  talentRequests TalentRequest[]
  notifications  Notification[]

  @@index([isActive, createdAt(sort: Desc)])
}

/// Server-side sessions. The cookie holds a random token; only its SHA-256 is stored here.
model MemberSession {
  id        String   @id
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([memberId])
  @@index([expiresAt])
}

/// An employer's company profile (one per account). Staff verify it before the employer can see applicants.
model Company {
  id        String   @id @default(cuid())
  memberId  String   @unique
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name      String
  sector    String   @default("OTHER")
  about     String?
  website   String?
  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs JobPost[]

  @@index([verified])
}

model SavedJob {
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  jobId     String
  job       JobPost  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([memberId, jobId])
  @@index([jobId])
}

/**
 * Job sectors ("sector") and tutoring subjects ("subject") that staff manage.
 * Built-in values live in code (src/lib/jobs-catalog.ts) with translated labels; a row here
 * renames, reorders or hides a built-in value, or adds a new one.
 */
model CatalogOption {
  id        String   @id @default(cuid())
  group     String
  /// Stable key stored on jobs, profiles and requests, e.g. "IT" or "SOLAR_TECH"
  value     String
  labelEn   String
  labelAm   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([group, value])
  @@index([group, isActive, sortOrder])
}

/// A job seeker's CV (PDF). Kept in the database, never in public storage; served only through /api/cv/[id] after an access check.
model CvFile {
  id        String    @id @default(cuid())
  seekerId  String    @unique
  seeker    JobSeeker @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  fileName  String
  size      Int
  data      Bytes
  createdAt DateTime  @default(now())
}

/// Updates shown in a member's account (status changes, new applicants, new student requests).
model Notification {
  id        String    @id @default(cuid())
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// e.g. APPLICATION_STATUS, JOB_STATUS, NEW_APPLICANT; rendered in the reader's language
  type      String
  data      Json      @default("{}")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([memberId, readAt])
  @@index([memberId, createdAt(sort: Desc)])
}
